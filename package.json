{
  "name": "kidseat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "node --env-file-if-exists=.env.local scripts/db-push.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-pantries.mjs",
    "db:import": "node --env-file-if-exists=.env.local scripts/import-pantries.mjs",
    "check:sms": "node scripts/check-sms-length.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node --env-file-if-exists=.env.local scripts/smoke.mts",
    "test": "npm run typecheck && npm run check:sms && npm run smoke"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.87",
    "@clickhouse/client": "^1.23.1",
