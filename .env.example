# ---------------------------------------------------------------------------
# ClickHouse Cloud — you're providing this.
# URL is the HTTPS endpoint, e.g. https://abc123.us-west-2.aws.clickhouse.cloud:8443
# ---------------------------------------------------------------------------
CLICKHOUSE_URL=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=sffood

# ---------------------------------------------------------------------------
# Secrets. Generate all four now — the app throws on boot without them.
#   PHONE_HASH_KEY / PHONE_ENC_KEY:  openssl rand -base64 32
#   SESSION_SECRET / CRON_SECRET:    openssl rand -hex 32
#
# PHONE_HASH_KEY is permanent. Rotating it orphans every existing subscriber,
# consent record, and message event, because phone_hash is the only join key.
# ---------------------------------------------------------------------------
PHONE_HASH_KEY=
PHONE_ENC_KEY=
SESSION_SECRET=
CRON_SECRET=

# ---------------------------------------------------------------------------
# SMS. `console` logs instead of sending — use it until 10DLC is approved.
# Switch to telnyx or twilio once you have a registered campaign and a number.
# ---------------------------------------------------------------------------
SMS_PROVIDER=console
SMS_FROM_NUMBER=

TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_PUBLIC_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# 211 Bay Area, for `npm run db:import`. Optional: the importer runs without it
# using the SF-Marin Food Bank locator alone, but that feed carries no prepared
# meals, home delivery, or halal/kosher/baby programs, so those needs match
# nothing until this is set. Keys come from apiportal.211.org.
# ---------------------------------------------------------------------------
TWO11_API_KEY=

# ---------------------------------------------------------------------------
# Gemini. Through the Vercel AI Gateway by default, so the model is a plain
# "provider/model" string. Set AI_GATEWAY_API_KEY, or use a direct Google key
# with GOOGLE_GENERATIVE_AI_API_KEY and AI_MODEL=gemini-...
#
# NOTE: verify the exact model id against the provider's current model list —
# if it 404s, this is the one value to change.
# ---------------------------------------------------------------------------
AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Google Maps Platform. Server-side only — do NOT prefix with NEXT_PUBLIC_.
# Enable on the key: Places API (New) and Routes API.
# Restrict it by API and by server IP; an unrestricted key on a public repo is
# somebody else's billing incident.
#
# Leave blank to run without Maps: the agent still answers from the curated
# pantries and pantry_events tables, it just cannot discover new sites.
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# Browser key for the map view. MUST be a SEPARATE key from the server one
# above: this value ships to the browser, so restrict it by HTTP referrer and
# enable only "Maps JavaScript API" on it. Never reuse the server key here.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Map ID for Advanced Markers. DEMO_MAP_ID works for development.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
